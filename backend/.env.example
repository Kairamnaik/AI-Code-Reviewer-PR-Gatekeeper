# Server Configuration
PORT=5001
JWT_SECRET=super_secret_jwt_sign_key_change_me
FRONTEND_URL=http://localhost:5173

# Database & Queue Configuration
# If left blank, the app will automatically run with a local JSON file DB and in-memory queue.
MONGODB_URI=mongodb://localhost:27017/ai-reviewer
REDIS_URL=redis://localhost:6379

# GitHub Integration
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_WEBHOOK_SECRET=your_github_webhook_payload_signing_secret

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_from_google_ai_studio

# (Optional) Webhook public URL (e.g. your public ngrok or smee URL)
# WEBHOOK_URL=https://your-tunnel-subdomain.ngrok-free.app/api/webhooks/github
